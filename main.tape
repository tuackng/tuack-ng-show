# 这是 Tuack-NG 快速入手视频的 VHS 脚本。

# 输出文件
Output tuack-ng.mp4

# 基础信息
Set Shell zsh
Set FontSize 48
Set FontFamily "Maple Mono Normal NL NF CN"
Set Width 3000
Set Height 1600
Set TypingSpeed 100ms
Set CursorBlink false
Set WindowBarTitle Tuack-NG

# 依赖信息
Require tuack-ng
Require typst
Require tree

# 设置终端提示符风格
Source tapes/init.tape

# Sections
# 0.1
Source tapes/0.1-intro.tape
# 0.2
Source tapes/0.2-requirements.tape

# 1.1
Source tapes/1.1-create.tape
